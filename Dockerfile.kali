# PentestAgent Kali Linux Image
# Full penetration testing environment

FROM kalilinux/kali-rolling

LABEL maintainer="Masic"
LABEL description="PentestAgent with Kali Linux tools"

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV TOKENIZERS_PARALLELISM=false

# Prevent post-install scripts from trying to start services inside the container
RUN printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d && chmod +x /usr/sbin/policy-rc.d

# TARGETARCH is injected by buildx (e.g. "amd64", "arm64")
ARG TARGETARCH

# Update and install Kali tools
# Note: kali-tools-* meta-packages are intentionally omitted — they pull in
# whatever is current in kali-rolling and frequently break on repo transitions.
# Individual packages below provide stable, reproducible installs.
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Python (python3-full includes venv with ensurepip)
    python3-full \
    python3-pip \
    # Web tools
    nikto \
    dirb \
    gobuster \
    sqlmap \
    wpscan \
    ffuf \
    feroxbuster \
    whatweb \
    wafw00f \
    # Recon / info-gathering
    nmap \
    theharvester \
    recon-ng \
    fierce \
    dnsenum \
    amass \
    # Exploitation / post-exploitation
    metasploit-framework \
    exploitdb \
    # Password / hash
    hydra \
    john \
    hashcat \
    # Scanning
    nuclei \
    # Network tools
    openvpn \
    wireguard \
    proxychains4 \
    tor \
    # Utilities
    curl \
    wget \
    git \
    vim \
    tmux \
    jq \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /usr/sbin/policy-rc.d

# Install amd64-only packages (burpsuite/zaproxy have no ARM64 Kali packages; xclip is x11-only)
RUN if [ "$TARGETARCH" = "amd64" ]; then \
      apt-get update \
      && apt-get install -y --no-install-recommends burpsuite zaproxy xclip \
      && apt-get clean \
      && rm -rf /var/lib/apt/lists/*; \
    fi

# Create app directory
WORKDIR /app

# Install Python dependencies using virtual environment (PEP 668 compliance)
COPY pyproject.toml README.md ./
RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip wheel setuptools

# Install heavy dependencies first (helps with CI memory limits)
RUN /opt/venv/bin/pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN /opt/venv/bin/pip install --no-cache-dir sentence-transformers faiss-cpu
RUN mkdir -p pentestagent && touch pentestagent/__init__.py && \
    /opt/venv/bin/pip install --no-cache-dir -e ".[rag]"

# Add venv to PATH
ENV PATH="/opt/venv/bin:$PATH"

# Copy application code
COPY . .

# Copy common wordlists
RUN mkdir -p /wordlists && \
    cp -r /usr/share/wordlists/* /wordlists/ 2>/dev/null || true

# Set permissions
RUN chmod +x /app/scripts/*.sh 2>/dev/null || true

# Entry point
COPY docker-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python3", "-m", "pentestagent"]
