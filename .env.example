# FlagHunter 环境变量配置示例
# 复制为 .env 后填入真实值，不要将 .env 提交到 Git
#
# cp .env.example .env
#
# 说明：环境变量已统一为 FLAGHUNTER_* 前缀。历史的 PENTESTAGENT_* 名称仍然
# 兼容（启动时自动别名为对应的 FLAGHUNTER_*），现有 .env 无需修改即可继续工作。

# 常见模型示例：
#   claude-sonnet-4-20250514         (Anthropic)
#   gpt-5                            (OpenAI)
#   openai/<relay-model-name>        (OpenAI-compatible relay)
#   gemini/gemini-2.5-flash          (Google，注意 gemini/ 前缀)
#   ollama/qwen2.5:7b-instruct       (本地 Ollama)
FLAGHUNTER_MODEL=gpt-5

# ---------------------------------------------------------------------------
# Custom API bases / relays
#
# OpenAI-compatible relay example:
# OPENAI_API_BASE=https://relay.example/v1
# FLAGHUNTER_MODEL=openai/<exact-model-name-from-your-relay>
#
# Anthropic-compatible endpoint example:
# ANTHROPIC_API_BASE=https://relay.example
# FLAGHUNTER_MODEL=anthropic/claude-opus-4-20250514
#
# Notes:
# - 不要使用 claude/... 作为 provider prefix；请用 anthropic/... 或 openai/...
# - 如果 relay 返回的模型名是 claude/claude-opus-4，请配置：
#   FLAGHUNTER_MODEL=openai/claude/claude-opus-4
# - 对 Anthropic-compatible endpoint，通常填写 host root 即可，LiteLLM 会自行追加 /v1/messages
# - 当 OPENAI_API_BASE 指向非官方地址时，embeddings 默认回退到本地 sentence-transformers；
#   若你的 relay 也支持 embeddings，可手动设 FLAGHUNTER_EMBEDDINGS=openai
#
# Web search tool（可选，需要 Tavily 账号）
TAVILY_API_KEY=


# ══════════════════════════════════════════════════════════════════
# M1 API Hub — 模块开关与全局参数
# ══════════════════════════════════════════════════════════════════

CPA_M1_API_HUB=true
CPA_M1_ENABLED=true

# 健康检查间隔（秒），默认 30
CPA_M1_HEALTH_CHECK_INTERVAL=30

# 健康检查超时（秒），默认 10
CPA_M1_HEALTH_CHECK_TIMEOUT=10

# 连续失败多少次后标记为 DOWN，默认 3
CPA_M1_FAIL_THRESHOLD=3

# DOWN 后多久做一次恢复检查（秒），默认 60
CPA_M1_RECOVERY_CHECK_INTERVAL=60

# 恢复确认所需的连续成功次数，默认 2
CPA_M1_RECOVERY_CONFIRM_REQUESTS=2

# 每日预算上限（USD），不设置则无限制
# CPA_M1_DAILY_BUDGET_USD=10.0

# 预算告警阈值（0~1），达到该比例时提示，默认 0.8
CPA_M1_BUDGET_ALERT_THRESHOLD=0.8


# ══════════════════════════════════════════════════════════════════
# M1 Provider 配置（可配置任意数量，从 0 开始编号）
# 必填：ID / NAME / MODEL / API_BASE / API_KEY
# 可选：PRIORITY（数字越小优先级越高）/ IS_BACKUP / TAGS / TIMEOUT
#       RPM_LIMIT / TPM_LIMIT / COST_PER_1K_INPUT / COST_PER_1K_OUTPUT
# ══════════════════════════════════════════════════════════════════

# ── Provider 0：主力中转站（优先级最高） ────────────────────────
CPA_PROVIDER_0_ID=relay-a-claude
CPA_PROVIDER_0_NAME=中转站A-Claude
CPA_PROVIDER_0_MODEL=claude-3-5-sonnet-20241022
CPA_PROVIDER_0_API_BASE=https://your-relay-a.example.com/v1
CPA_PROVIDER_0_API_KEY=sk-your-relay-a-key
CPA_PROVIDER_0_PRIORITY=1
CPA_PROVIDER_0_TIMEOUT=60
CPA_PROVIDER_0_RPM_LIMIT=60
CPA_PROVIDER_0_COST_PER_1K_INPUT=0.003
CPA_PROVIDER_0_COST_PER_1K_OUTPUT=0.015
CPA_PROVIDER_0_TAGS=claude,primary

# ── Provider 1：备用中转站 ───────────────────────────────────────
CPA_PROVIDER_1_ID=relay-b-claude
CPA_PROVIDER_1_NAME=中转站B-Claude
CPA_PROVIDER_1_MODEL=claude-3-5-sonnet-20241022
CPA_PROVIDER_1_API_BASE=https://your-relay-b.example.com/v1
CPA_PROVIDER_1_API_KEY=sk-your-relay-b-key
CPA_PROVIDER_1_PRIORITY=2
CPA_PROVIDER_1_IS_BACKUP=true
CPA_PROVIDER_1_TAGS=claude,backup

# ── Provider 2：官方 OpenAI（可选） ─────────────────────────────
# CPA_PROVIDER_2_ID=openai-official
# CPA_PROVIDER_2_NAME=官方-GPT4
# CPA_PROVIDER_2_MODEL=gpt-4o
# CPA_PROVIDER_2_API_BASE=https://api.openai.com/v1
# CPA_PROVIDER_2_API_KEY=sk-your-openai-key
# CPA_PROVIDER_2_PRIORITY=3
# CPA_PROVIDER_2_COST_PER_1K_INPUT=0.005
# CPA_PROVIDER_2_COST_PER_1K_OUTPUT=0.015
# CPA_PROVIDER_2_TAGS=gpt,official


# ══════════════════════════════════════════════════════════════════
# M1 降级链配置（按序切换，从 0 开始编号）
# MODEL_PATTERN：触发降级的模型匹配模式（支持通配符 *）
# PROVIDER_IDS：降级顺序，逗号分隔的 Provider ID
# ══════════════════════════════════════════════════════════════════

CPA_M1_FALLBACK_0_MODEL=claude*
CPA_M1_FALLBACK_0_PROVIDER_IDS=relay-a-claude,relay-b-claude

# CPA_M1_FALLBACK_1_MODEL=gpt-4*
# CPA_M1_FALLBACK_1_PROVIDER_IDS=openai-official,relay-a-claude


# ══════════════════════════════════════════════════════════════════
# M2 CTF Kit — 模块开关
# ══════════════════════════════════════════════════════════════════

CPA_M2_ENABLED=true

# CTF 解题链缺工具时是否自动安装（默认关闭；需要用户明确开启）
FLAGHUNTER_AUTO_INSTALL=false

# CTFd/HTB/THM Flag 提交配置（可选）
# CPA_CTF_PLATFORM=ctfd
# CPA_CTF_URL=https://your-ctf.example.com
# CPA_CTF_TOKEN=your-ctf-token


# ══════════════════════════════════════════════════════════════════
# M3 报告生成 — 模块开关
# ══════════════════════════════════════════════════════════════════

CPA_M3_ENABLED=false


# ══════════════════════════════════════════════════════════════════
# M4 审计合规 — 模块开关
# ══════════════════════════════════════════════════════════════════

CPA_M4_ENABLED=false


# ══════════════════════════════════════════════════════════════════
# M5 多Agent协作 — 模块开关
# ══════════════════════════════════════════════════════════════════

CPA_M5_ENABLED=false


# ══════════════════════════════════════════════════════════════════
# M6 性能优化 — 模块开关
# ══════════════════════════════════════════════════════════════════

CPA_M6_ENABLED=false

# Kali VM SSH Runtime（可选，替代 LocalRuntime 在 Kali 上执行工具）
# KALI_SSH_HOST=192.168.x.x
# KALI_SSH_PORT=22
# KALI_SSH_USER=root
# KALI_SSH_KEY_PATH=~/.ssh/id_rsa

# ---------------------------------------------------------------------------
# Debug logging
# FLAGHUNTER_DEBUG=false
